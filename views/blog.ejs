<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Blogify | Blog</title>
    <style>
        body {
            background-color: #141414;
            color: #fff;
            font-family: 'Helvetica Neue', sans-serif;
            margin: 0;
        }

        .container {
            max-width: 900px;
            margin: 40px auto;
            padding: 2rem;
            background-color: #1c1c1c;
            border-radius: 12px;
        }

        h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            text-align: center;
        }

        img {
            display: block;
            max-width: 100%;
            margin: 0 auto 20px;
            border-radius: 12px;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.1);
        }

        h4 {
            font-size: 1.2rem;
            line-height: 1.8;
            margin-bottom: 2rem;
            color: #d1d5db;
        }

        .summary {
            background: #222835;
            border-radius: 10px;
            padding: 1rem 1.2rem;
            margin-bottom: 2rem;
            color: #e5e7eb;
        }

        .meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            justify-content: space-between;
            font-size: 0.95rem;
            color: #bbb;
            margin-bottom: 1.5rem;
        }

        .meta a {
            color: #9dd6ff;
            text-decoration: none;
        }

        .meta a:hover {
            color: #fff;
        }

        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
        }

        .tag {
            background-color: #2c3240;
            color: #cbd5f5;
            padding: 0.3rem 0.7rem;
            border-radius: 999px;
            font-size: 0.75rem;
        }

        .comment-section {
            border-top: 1px solid #333;
            margin-top: 3rem;
            padding-top: 2rem;
        }

        .comment {
            background-color: #2c2c2c;
            padding: 1rem;
            margin-bottom: 1rem;
            border-radius: 8px;
        }

        .comment-author {
            font-weight: bold;
            margin-bottom: 0.5rem;
            color: #e50914;
        }

        .comment-content pre {
            white-space: pre-wrap;
            color: #ddd;
        }

        .comment-form input {
            padding: 10px;
            border: none;
            border-radius: 4px;
            width: 75%;
            background-color: #333;
            color: white;
        }

        .comment-form button {
            padding: 10px 15px;
            background-color: #e50914;
            border: none;
            border-radius: 4px;
            color: white;
            margin-left: 10px;
            cursor: pointer;
        }

        .comment-form button:hover {
            background-color: #f40612;
        }
    </style>
</head>
<body>
    <%- include('./partials/nav') %>

    <div class="container">
        <h1><%= blog.title %></h1>
        <img src="<%= blog.coverImageURL %>" alt="Cover Image">
        <div class="meta">
            <span><%= blog.sourceName || (blog.createdBy ? blog.createdBy.fullName : 'Community') %></span>
            <% if (blog.sourceUrl) { %>
                <span><a href="<%= blog.sourceUrl %>" target="_blank" rel="noreferrer">Read original source ↗</a></span>
            <% } %>
            <% if (blog.sourcePublishedAt) { %>
                <span>Published: <%= new Date(blog.sourcePublishedAt).toLocaleDateString() %></span>
            <% } %>
        </div>
        <% if (blog.summary) { %>
            <div class="summary">
                <strong>AI Summary:</strong> <%= blog.summary %>
            </div>
        <% } %>
        <div class="tags">
            <% (blog.categories || []).forEach(category => { %>
                <span class="tag"><%= category %></span>
            <% }) %>
        </div>
        <h4><%= blog.body %></h4>
        <div class="meta">
            <span>Author: <%= blog.createdBy ? blog.createdBy.fullName : 'Auto-curated' %></span>
        </div>

        <div class="comment-section">
            <h2>Comments (<%= comments.length %>)</h2>

            <% if (locals.user) { %>
                <form action="/blog/comment/<%= blog._id %>" method="post" class="comment-form">
                    <input type="text" name="content" placeholder="Enter your comment..." required />
                    <button type="submit">Add</button>
                </form>
            <% } %>

            <% comments.forEach(comment => { %>
                <div class="comment">
                    <div class="comment-author"><%= comment.createdBy.fullName %></div>
                    <div class="comment-content">
                        <pre><%= comment.content %></pre>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <%- include('./partials/scripts') %>
</body>
</html>
