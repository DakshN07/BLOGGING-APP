<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Blogify | Home</title>
    <style>
        body {
            background-color: #0f1115;
            color: #ffffff;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        }

        .hero {
            padding: 3rem 1.5rem 1.5rem;
            text-align: center;
        }

        .hero h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .hero p {
            color: #b6b6b6;
            max-width: 720px;
            margin: 0 auto;
            font-size: 1.1rem;
        }

        .filters {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.75rem;
            margin-top: 1.5rem;
        }

        .filter-pill {
            padding: 0.35rem 0.9rem;
            border-radius: 999px;
            background-color: #1d222b;
            color: #c8d0dc;
            font-size: 0.85rem;
            border: 1px solid #2d3340;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            padding: 1.5rem 2rem 3rem;
        }

        .blog-card {
            background-color: #1b1f27;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid #262c36;
            display: flex;
            flex-direction: column;
            min-height: 100%;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .blog-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 35px rgba(0, 0, 0, 0.45);
        }

        .blog-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            display: block;
        }

        .card-body {
            padding: 1.2rem 1.3rem 1.4rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            flex: 1;
        }

        .meta-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            font-size: 0.85rem;
            color: #8f96a3;
        }

        .badge {
            background: rgba(229, 9, 20, 0.2);
            color: #ff6b6b;
            padding: 0.15rem 0.5rem;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.75rem;
        }

        .tag-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
        }

        .tag {
            background-color: #242a35;
            color: #c3c9d5;
            font-size: 0.7rem;
            padding: 0.2rem 0.5rem;
            border-radius: 999px;
        }

        .blog-card h5 {
            font-size: 1.2rem;
            font-weight: 600;
            margin: 0;
        }

        .blog-card p {
            color: #c2c8d0;
            font-size: 0.95rem;
            line-height: 1.4;
            flex: 1;
        }

        .card-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .blog-card a.btn {
            background-color: #e50914;
            border: none;
            color: white;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: background-color 0.2s;
        }

        .blog-card a.btn:hover {
            background-color: #f40612;
        }

        .source-link {
            color: #7f8aa3;
            text-decoration: none;
            font-size: 0.85rem;
        }

        .source-link:hover {
            color: #fff;
        }
    </style>
</head>
<body>
    <%- include('./partials/nav') %>

    <section class="hero">
        <h1>Smart Tech & AI Digest</h1>
        <p>Freshly curated tech, engineering, and AI stories. Every week we auto-collect at least three new posts and summarize them with AI so you can move faster.</p>
        <div class="filters">
            <span class="filter-pill">Weekly Auto-Curation</span>
            <span class="filter-pill">AI Summaries</span>
            <span class="filter-pill">Engineering</span>
            <span class="filter-pill">Technology</span>
            <span class="filter-pill">AI</span>
        </div>
    </section>

    <div class="grid">
        <% blog.forEach(blog => { %>
            <div class="blog-card">
                <img src="<%= blog.coverImageURL %>" alt="Blog Cover">
                <div class="card-body">
                    <div class="meta-row">
                        <span><%= blog.sourceName || (blog.createdBy ? blog.createdBy.fullName : 'Community') %></span>
                        <% if (blog.isAutoGenerated) { %>
                            <span class="badge">AI Curated</span>
                        <% } %>
                    </div>
                    <h5><%= blog.title %></h5>
                    <p><%= (blog.summary || blog.body).slice(0, 180) %><%= (blog.summary || blog.body).length > 180 ? "..." : "" %></p>
                    <div class="tag-row">
                        <% (blog.categories || []).forEach(category => { %>
                            <span class="tag"><%= category %></span>
                        <% }) %>
                    </div>
                    <div class="card-actions">
                        <a href="/blog/<%= blog._id %>" class="btn">View</a>
                        <% if (blog.sourceUrl) { %>
                            <a class="source-link" href="<%= blog.sourceUrl %>" target="_blank" rel="noreferrer">Source ↗</a>
                        <% } %>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <%- include('./partials/scripts') %>
</body>
</html>
